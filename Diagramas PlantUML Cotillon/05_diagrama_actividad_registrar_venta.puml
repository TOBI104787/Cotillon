@startuml
title Sistema de Gestion para un Cotillon - Actividad: Registrar Venta
skinparam shadowing false

start

note top
  Actor: Empleado o responsable del negocio
  Precondicion: tiene la sesion iniciada.
end note

|Empleado o responsable del negocio|
:Iniciar una nueva venta;

|Sistema|
:Crear objeto Venta en preparacion;

repeat
  |Empleado o responsable del negocio|
  :Buscar producto por nombre;
  :Indicar cantidad;

  |Sistema|
  :Consultar producto en RepositorioProducto;

  if (¿Producto encontrado?) then (Si)
    :Consultar stock disponible;
    if (¿Hay stock suficiente?) then (Si)
      :Crear objeto DetalleVenta;
      :Calcular subtotal;
      :Agregar detalle a Venta;
      :Mostrar descripcion y subtotal;
    else (No)
      :Informar stock insuficiente;
      |Empleado o responsable del negocio|
      :Modificar cantidad o elegir otro producto;
    endif
  else (No)
    :Informar que el producto no existe;
  endif

repeat while (¿Desea agregar otro producto?) is (Si) not (No)

|Sistema|
if (¿La venta tiene al menos un detalle?) then (Si)
  :Calcular total de la venta;
  :Mostrar detalle y total;
  :Solicitar confirmacion;

  |Empleado o responsable del negocio|
  :Confirmar la venta;

  |Sistema|
  :Iniciar transaccion en UnidadDeTrabajo;
  :Guardar Venta y sus DetalleVenta;
  :Descontar stock de cada Producto;
  if (¿Todas las operaciones finalizaron correctamente?) then (Si)
    :Confirmar transaccion;
    :Informar venta registrada;
  else (No)
    :Revertir transaccion;
    :Informar que no se pudo registrar la venta;
  endif
else (No)
  :Informar que la venta debe contener al menos un producto;
endif

stop
@enduml